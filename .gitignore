# ---------- 大数据与训练产物（勿提交 GitHub）----------
# 原始与预处理数据（含 OULAD）
data/

# 主仓库训练输出（保留说明文档）
outputs/*
!outputs/README.md

# 下游子目录内生成数据与权重（保留 .gitkeep 占位）
downstream_pass_prediction/data/*
!downstream_pass_prediction/data/.gitkeep
downstream_pass_prediction/outputs/*
!downstream_pass_prediction/outputs/.gitkeep

# Baseline 跑分输出（json/csv）
baseline/results/

# PyTorch 权重 / 检查点（体积大）
*.pth
*.pt
*.ckpt

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
*.egg

