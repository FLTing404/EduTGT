# Local backups of the original nested Git repositories and organization inventory.
/.local/

# Large OULAD inputs and generated graph tables stay on the local machine.
# Processing scripts, notebooks, metadata, labels and student splits are tracked.
/data/OULAD/
/EduTGT/data/raw/OULAD/
/EduTGT/data/processed/*/*
!/EduTGT/data/processed/*/*.json

# Python environments and generated caches.
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editor and operating-system temporary files.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
